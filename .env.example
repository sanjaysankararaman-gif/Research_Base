# Copy this file to .env and adjust. Every value is optional.
# Never commit .env — it is listed in .gitignore.

# Contact e-mail sent to Crossref and OpenAlex ("polite pool").
# Gives more reliable rate limits. Use a departmental address.
CONTACT_EMAIL=

# Optional API keys. The application works without them, but Semantic
# Scholar's shared unauthenticated pool is frequently rate limited.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

# Storage
# Hosted Postgres, e.g. Supabase (keeps the library permanently). Not set = SQLite file;
# on Vercel that file is temporary and the library resets when the app restarts.
# Supabase: Project -> Connect -> "Session pooler" connection string.
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Without DATABASE_URL a local SQLite file is used:
# DATABASE_PATH=data/research_data.db
# LOG_DIR=logs
LOG_LEVEL=INFO

# Outbound request behaviour
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
MAX_RETRY_WAIT_SECONDS=30
# Most time one source may take for one DOI, retries included
SOURCE_TIME_BUDGET_SECONDS=40

# Minimum seconds between two requests to the same source
CROSSREF_MIN_INTERVAL=0.1
OPENALEX_MIN_INTERVAL=0.15
SEMANTIC_SCHOLAR_MIN_INTERVAL=1.0

# Extraction limits
MAX_DOIS_PER_REQUEST=200
DOI_CONCURRENCY=3

# ---- Indexing database checks (field 8) — official APIs, institutional keys
# Elsevier Scopus Search API key: https://dev.elsevier.com/
SCOPUS_API_KEY=
# Clarivate Web of Science Starter API key: https://developer.clarivate.com/apis/wos-starter
WOS_API_KEY=

# ---- Journal-level metrics (fields 14 and 15), files supplied by the department
# SCImago journal ranking CSV (free download from scimagojr.com) -> Quartile.
# By default the newest reference/scimagojr*.csv in the repository is used.
# SJR_CSV_PATH=reference/scimagojr_2025.csv
# CSV with columns issn,impact_factor[,year] exported from JCR (licensed) -> Impact Factor
# IMPACT_FACTOR_CSV_PATH=reference/impact_factors.csv

# ---- Home institution (fields 25-26)
# Defaults: Shiv Nadar University, Chennai; ROR 039rg7508 (SNU Chennai) and 054psm803 (SSN College
# of Engineering); aliases are matched against affiliation text (every word must appear).
# HOME_INSTITUTION_NAME=Shiv Nadar University, Chennai
# HOME_INSTITUTION_ROR=039rg7508,054psm803
# HOME_INSTITUTION_ALIASES=Shiv Nadar University Chennai; Shiv Nadar Kalavakkam; SNU Chennai; Sivasubramaniya Nadar; SSN College of Engineering; SSN School of Engineering
# Teachers and their faculty IDs
# FACULTY_CSV_PATH=reference/faculty.csv

# ---- Optional Supabase copy as normalized tables for reports (Transaction pooler, port 6543).
# Run backend/integrations/database/supabase_schema.sql once in the Supabase SQL editor first.
# SUPABASE_DB_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Browser origins allowed to call the API (comma-separated). * = any (local dev)
CORS_ORIGINS=*

# Excel file every looked-up paper is saved to (rebuilt after each add/delete)
# EXCEL_PATH=data/research_papers.xlsx
